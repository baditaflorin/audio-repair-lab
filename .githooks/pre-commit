#!/usr/bin/env sh
# Docs-only commits (just CLAUDE.md, the fleet-wide canonical doc sync)
# skip the full check suite below — it has nothing to check.
if [ "$(git diff --cached --name-only)" = "CLAUDE.md" ]; then
  exit 0
fi
set -eu

npm run lint
npm run fmt:check
npm run typecheck

if command -v gitleaks >/dev/null 2>&1; then
  gitleaks protect --staged --redact
else
  echo "gitleaks is required for pre-commit secret scanning. Install it and retry." >&2
  exit 1
fi
