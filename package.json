{
  "name": "audio-repair-lab",
  "version": "0.2.0",
  "private": false,
  "description": "Browser-based audio repair toolkit for noise removal, vocal isolation, and quick podcast/music cleanup.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/baditaflorin/audio-repair-lab.git"
  },
  "homepage": "https://baditaflorin.github.io/audio-repair-lab/",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "prebuild": "node scripts/clean-pages.mjs",
    "build": "vite build && node scripts/copy-404.mjs",
    "pages-preview": "vite preview --host 0.0.0.0 --outDir docs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "smoke": "npm run build && node scripts/serve-pages-and-smoke.mjs",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "fmt": "prettier --write .",
    "fmt:check": "prettier --check ."
  },
  "dependencies": {
    "@tanstack/react-query": "^5.90.12",
    "comlink": "^4.4.2",
    "fft.js": "^4.0.4",
    "idb": "^8.0.3",
    "lucide-react": "^0.475.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.18.0",
    "@playwright/test": "^1.50.1",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@types/node": "^22.10.7",
    "@types/react": "^19.0.7",
    "@types/react-dom": "^19.0.3",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.18.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "globals": "^17.6.0",
    "jsdom": "^26.0.0",
    "postcss": "^8.5.1",
    "prettier": "^3.4.2",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.21.0",
    "vite": "^6.0.7",
    "vitest": "^4.1.0"
  }
}
